{
  "name": "wearepixel/laravel-cart",
  "version": "2.1.4",
  "description": "A cart implementation for Laravel",
  "keywords": [
    "laravel",
    "shopping cart",
    "cart"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Darryl Fernandez",
      "email": "engrdarrylfernandez@gmail.com"
    },
    {
      "name": "Joel Male",
      "email": "joel@joelmale.com"
    }
  ],
  "require": {
    "php": ">=8.3",
    "illuminate/support": "^11.0|^12.0|^13.0",
    "illuminate/auth": "^11.0|^12.0|^13.0",
    "illuminate/container": "^11.0|^12.0|^13.0",
    "illuminate/database": "^11.0|^12.0|^13.0",
    "illuminate/validation": "^11.0|^12.0|^13.0"
  },
  "require-dev": {
    "mockery/mockery": "^2.0",
    "laravel/pint": "^1.21",
    "pestphp/pest": "^4.7",
    "larapack/dd": "dev-master"
  },
  "autoload": {
    "psr-4": {
      "Wearepixel\\Cart\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "minimum-stability": "dev",
  "extra": {
    "laravel": {
      "providers": [
        "Wearepixel\\Cart\\CartServiceProvider"
      ],
      "aliases": {
        "Cart": "Wearepixel\\Cart\\Facades\\CartFacade"
      }
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
